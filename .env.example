# Copy to .env (never commit .env)

# Claude: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Defaults to https://api.anthropic.com (the shell's ANTHROPIC_BASE_URL is ignored on purpose)
# CLAUDE_BASE_URL=

# ElevenLabs: https://elevenlabs.io -> Developers -> API Keys
# Without a key the app uses the macOS `say` voice (dev only).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# Adobe Firefly Services (OAuth server-to-server credential). Optional:
# without it, images get a blurred-background 9:16 fill.
FIREFLY_CLIENT_ID=
FIREFLY_CLIENT_SECRET=

# TikTok for Developers app (Login Kit + Content Posting API). Optional:
# without it, videos can still be downloaded.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/tiktok/callback
FRONTEND_URL=http://localhost:5173

# Infra
PUBLIC_BASE_URL=http://localhost:8000
# REDIS_URL=redis://localhost:6379/0
MAX_PARALLEL_JOBS=2
