# Copy to .env at the repo root and fill in. Never commit the real .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GEMINI_API_KEY=
TICKETMASTER_API_KEY=
ELEVENLABS_API_KEY=
FIREFLY_CLIENT_ID=
FIREFLY_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/tiktok/callback
# Where the browser lands after approving TikTok login (default: the studio page)
# TIKTOK_AFTER_LOGIN_URL=http://localhost:8000/studio

# --- City index (heatmap, signal feed) ---
# Weather: Open-Meteo, no key needed. Search interest: Google Trends per county, no key needed.
# Events: data/ro_events.json is a hand-curated list (Ticketmaster has no events in Romania,
# so TICKETMASTER_API_KEY has no effect for Romanian cities).
# Set to 0 to skip Google Trends (the cities then simply have no search signal).
CITYPULSE_LIVE_TRENDS=1
# Set to 1 to also show the "(demo)" events re-dated to the next weekend.
# CITYPULSE_DEMO_EVENTS=0
FRONTEND_URL=http://localhost:3000

# Infra
PUBLIC_BASE_URL=http://localhost:8000
# REDIS_URL=redis://localhost:6379/0
MAX_PARALLEL_JOBS=2
